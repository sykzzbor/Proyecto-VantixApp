# ============================================================
# VantixApp — variables de entorno
# Copiar este archivo a .env y completar los valores reales.
# ============================================================

# PostgreSQL administrado. En Vercel usá la URL con pooling que entregue el proveedor.
# Debe incluir TLS/SSL y nunca apuntar a localhost en Production o Preview.
DATABASE_URL=""

# Secreto para firmar sesiones. Generar uno real con: openssl rand -base64 32
BETTER_AUTH_SECRET=""

# URL pública HTTPS canónica de la aplicación, sin barra final.
BETTER_AUTH_URL="https://vantixapp.com.ar"

# ============================================================
# Correo transaccional (verificación, recuperación, avisos).
# SIN ESTO NADIE PUEDE REGISTRARSE: la verificación de correo es obligatoria.
# ============================================================
# Valores admitidos: resend, console, none.
# Si se deja vacío: "resend" cuando hay RESEND_API_KEY; si no, "console" en
# desarrollo y "none" en producción.
EMAIL_PROVIDER="resend"
# API key de Resend: https://resend.com/api-keys
RESEND_API_KEY=""
# Remitente. El dominio debe estar verificado en Resend.
# En el panel de Vercel pegá el valor SIN las comillas:
#   Vantix <no-reply@vantixapp.com.ar>
# Resend rechaza con 422 cualquier otro formato y no se envía ningún correo.
EMAIL_FROM="Vantix <no-reply@vantixapp.com.ar>"
# Opcional: dirección a la que responden los usuarios.
EMAIL_REPLY_TO=""

# ============================================================
# Agente de IA — todas las claves viven SOLO en el servidor.
# ============================================================
# Valores admitidos: demo, openai, anthropic.
# Usar "demo" evita llamadas pagas y respuestas automáticas hacia canales reales.
AI_PROVIDER="demo"
# OpenAI: https://platform.openai.com/api-keys
OPENAI_API_KEY=""
# Modelo a usar con la Responses API (por defecto: gpt-5-mini)
OPENAI_MODEL=""
# Anthropic: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-haiku-4-5-20251001"

# ============================================================
# WhatsApp Cloud API - todos estos valores viven SOLO en el servidor.
# ============================================================
# App ID público usado por Facebook Login for Business.
META_APP_ID=""
# Configuration ID público del flujo oficial Meta Embedded Signup.
META_EMBEDDED_SIGNUP_CONFIG_ID=""
# Token compartido para la verificacion GET del webhook.
WHATSAPP_VERIFY_TOKEN=""
# App Secret de Meta usado para validar X-Hub-Signature-256.
META_APP_SECRET=""
# Versión explícita de Graph API habilitada para tu aplicación, con formato vN.N.
META_GRAPH_API_VERSION=""
# Clave AES-256: exactamente 32 bytes codificados como 64 hex o base64.
CREDENTIALS_ENCRYPTION_KEY=""
# Debe permanecer en false en Vercel. El simulador también valida NODE_ENV.
WHATSAPP_DEV_MODE="false"

# ============================================================
# YCloud Coexistence - credenciales SOLO en el servidor.
# La API key de cada organización se carga desde Integraciones y queda cifrada.
# ============================================================
# Signing secret del endpoint creado en YCloud Developers > Webhooks.
# Se usa para validar el header YCloud-Signature; no es la API key.
YCLOUD_WEBHOOK_SECRET=""

# ============================================================
# Almacenamiento de documentos (Centro de conocimiento) - solo servidor.
# ============================================================
# Vercel inyecta BLOB_STORE_ID y credenciales OIDC temporales automáticamente
# al conectar el Blob privado. No copies ni configures manualmente el token OIDC.
BLOB_STORE_ID=""
# Fallback opcional para usar el Blob fuera de Vercel. Si se omite fuera de
# Vercel, los archivos se guardan en el filesystem local (./.storage).
# BLOB_WEBHOOK_PUBLIC_KEY no es una credencial de almacenamiento.
BLOB_READ_WRITE_TOKEN=""

# ============================================================
# Automatización (Etapa 6A) — VantixApp <-> n8n.
# Todos los secretos viven SOLO en el servidor. Nunca usar NEXT_PUBLIC_.
# ============================================================
# Proveedor activo: "mock" (por defecto, permite probar sin cuenta de n8n) o "n8n".
AUTOMATION_PROVIDER="mock"
# URL del webhook de n8n. Debe ser HTTPS en producción y nunca apuntar a una red
# privada/loopback. Nunca proviene del navegador ni de parámetros del usuario.
N8N_WEBHOOK_URL=""
# Secreto HMAC SHA-256 con el que VantixApp firma el webhook saliente hacia n8n.
N8N_WEBHOOK_SECRET=""
# Secreto HMAC SHA-256 para callback y acciones firmadas entrantes desde n8n.
# La acción de seguimiento firma timestamp + IDs; nunca acepta teléfono ni mensaje.
N8N_CALLBACK_SECRET=""
# Confirmación no secreta. Cambiar a true solo después de publicar los 4 workflows.
N8N_WORKFLOWS_PUBLISHED="false"
# Secreto del endpoint interno POST/GET /api/automation/dispatch (procesa la cola).
# En Vercel Cron, configurar CRON_SECRET con este mismo valor.
AUTOMATION_CRON_SECRET=""
# Señal no secreta. Mantener false hasta que el dispatcher esté configurado y autorizado.
AUTOMATION_DISPATCHER_ENABLED="false"
# Timeout de la request hacia n8n, en ms (rango 1000-60000; por defecto 10000).
AUTOMATION_REQUEST_TIMEOUT_MS="10000"
# Máximo de intentos por evento antes de pasar a DEAD_LETTER (rango 1-20; por defecto 5).
AUTOMATION_MAX_ATTEMPTS="5"

# ============================================================
# Google Calendar (Etapa 6D.1A) - credenciales OAuth del servidor.
# Ver docs/GOOGLE_CALENDAR_SETUP.md. Nunca usar NEXT_PUBLIC_.
# ============================================================
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# OAuth Client dedicado recomendado para login. Si ambos se omiten, Better Auth
# reutiliza GOOGLE_CLIENT_ID/GOOGLE_CLIENT_SECRET solicitando solo identidad.
GOOGLE_AUTH_CLIENT_ID=""
GOOGLE_AUTH_CLIENT_SECRET=""

# ============================================================
# Google Sheets - OAuth aislado de Login y Google Calendar.
# Callback: /api/integrations/google-sheets/callback
# ============================================================
GOOGLE_SHEETS_CLIENT_ID=""
GOOGLE_SHEETS_CLIENT_SECRET=""

# ============================================================
# Planes en ARS - fallback opcional si DolarHoy no responde.
# ============================================================
# Fallback opcional para precios en ARS si la referencia externa no responde.
PLANS_USD_ARS_RATE=""
PLANS_USD_ARS_UPDATED_AT=""

# ============================================================
# Facturación con Mercado Pago - secretos SOLO en el servidor.
# Correo autorizado para habilitar el modo interno temporal de plan.
# Se valida exclusivamente en servidor y nunca se devuelve al navegador.
INTERNAL_PLAN_OVERRIDE_EMAIL=
# Token privado de producción para consultar y administrar suscripciones.
MERCADO_PAGO_ACCESS_TOKEN=""
# Firma secreta configurada para:
# https://vantixapp.com.ar/api/webhooks/mercado-pago
MERCADO_PAGO_WEBHOOK_SECRET=""
# Solo se usa si MERCADO_PAGO_ACCESS_TOKEN comienza con TEST-. Se ignora con
# credenciales productivas y nunca modifica el precio comercial del snapshot.
MERCADO_PAGO_TEST_AMOUNT_ARS="100"
# Origen público HTTPS canónico, sin barra final. Se usa en retornos de
# checkout, OAuth y registro de webhooks de integraciones.
NEXT_PUBLIC_APP_URL="https://vantixapp.com.ar"

# ============================================================
# Tiendanube - OAuth y webhooks (solo servidor salvo la URL pública).
# Callback: https://vantixapp.com.ar/api/integrations/tiendanube/callback
# Webhook: https://vantixapp.com.ar/api/webhooks/tiendanube
# ============================================================
TIENDANUBE_APP_ID=""
TIENDANUBE_CLIENT_SECRET=""

# ============================================================
# WooCommerce - cada organización carga su URL, Consumer Key y Consumer Secret
# desde Integraciones. No existen credenciales globales en el entorno.
# Webhook por conexión:
# https://vantixapp.com.ar/api/webhooks/woocommerce/{webhookKey}
# ============================================================

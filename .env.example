# ============================================================
# VantixApp — variables de entorno
# Copiar este archivo a .env y completar los valores reales.
# ============================================================

# PostgreSQL administrado. En Vercel usá la URL con pooling que entregue el proveedor.
# Debe incluir TLS/SSL y nunca apuntar a localhost en Production o Preview.
DATABASE_URL=""

# Secreto para firmar sesiones. Generar uno real con: openssl rand -base64 32
BETTER_AUTH_SECRET=""

# URL pública HTTPS de la aplicación, sin barra final.
BETTER_AUTH_URL=""

# ============================================================
# Agente de IA (OpenAI) — la clave vive SOLO en el servidor.
# ============================================================
# Crear una clave en https://platform.openai.com/api-keys
# Usar "demo" evita llamadas pagas y respuestas automaticas hacia canales reales.
AI_PROVIDER="demo"
OPENAI_API_KEY=""
# Modelo a usar con la Responses API (por defecto: gpt-5-mini)
OPENAI_MODEL="gpt-5-mini"

# ============================================================
# WhatsApp Cloud API - todos estos valores viven SOLO en el servidor.
# ============================================================
# Token compartido para la verificacion GET del webhook.
WHATSAPP_VERIFY_TOKEN=""
# App Secret de Meta usado para validar X-Hub-Signature-256.
META_APP_SECRET=""
# Versión explícita de Graph API habilitada para tu aplicación, con formato vN.N.
META_GRAPH_API_VERSION=""
# Clave AES-256: exactamente 32 bytes codificados como 64 hex o base64.
CREDENTIALS_ENCRYPTION_KEY=""
# Debe permanecer en false en Vercel. El simulador también valida NODE_ENV.
WHATSAPP_DEV_MODE="false"

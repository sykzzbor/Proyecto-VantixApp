# ============================================================
# VantixApp — variables de entorno
# Copiar este archivo a .env y completar los valores reales.
# ============================================================

# Conexión a PostgreSQL.
# Local:      postgresql://USUARIO:CONTRASEÑA@localhost:5432/vantixapp?schema=public
# Neon:       postgresql://...@....neon.tech/vantixapp?sslmode=require
# Supabase:   postgresql://postgres:...@db....supabase.co:5432/postgres
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/vantixapp?schema=public"

# Opcional: solo si usás `npx prisma dev` como base local.
# Es la SHADOW_DATABASE_URL que imprime ese comando (necesaria para `prisma migrate dev`).
# SHADOW_DATABASE_URL=""

# Secreto para firmar sesiones. Generar uno real con: openssl rand -base64 32
BETTER_AUTH_SECRET=""

# URL pública de la aplicación (sin barra final)
BETTER_AUTH_URL="http://localhost:3000"

# ============================================================
# Agente de IA (OpenAI) — la clave vive SOLO en el servidor.
# ============================================================
# Crear una clave en https://platform.openai.com/api-keys
# Usar "demo" evita llamadas pagas y respuestas automaticas hacia canales reales.
AI_PROVIDER=demo
OPENAI_API_KEY=""
# Modelo a usar con la Responses API (por defecto: gpt-5-mini)
OPENAI_MODEL="gpt-5-mini"

# ============================================================
# WhatsApp Cloud API - todos estos valores viven SOLO en el servidor.
# ============================================================
# Token compartido para la verificacion GET del webhook.
WHATSAPP_VERIFY_TOKEN=
# App Secret de Meta usado para validar X-Hub-Signature-256.
META_APP_SECRET=
# Version explicita de Graph API, por ejemplo: v23.0
META_GRAPH_API_VERSION=
# Clave AES-256: exactamente 32 bytes codificados como 64 hex o base64.
CREDENTIALS_ENCRYPTION_KEY=
# El simulador solo se habilita fuera de produccion y con este valor en true.
WHATSAPP_DEV_MODE=true

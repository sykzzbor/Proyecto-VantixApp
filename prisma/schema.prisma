generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// Autenticación (tablas gestionadas por Better Auth)
// ============================================================

model User {
  id            String   @id
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions               Session[]
  accounts               Account[]
  memberships            OrganizationMember[]
  auditLogs              AuditLog[]
  invitations            Invitation[]                    @relation("InvitedBy")
  assignedConversations  Conversation[]                  @relation("AssignedConversations")
  sentMessages           Message[]                       @relation("SentMessages")
  knowledgeUploads       KnowledgeDocument[]             @relation("KnowledgeUploads")
  createdAutomationRules OrganizationAutomationRule[]    @relation("AutomationRuleCreatedBy")
  updatedAutomationRules OrganizationAutomationRule[]    @relation("AutomationRuleUpdatedBy")
  whatsappSignupAttempts WhatsappEmbeddedSignupAttempt[]
  createdAppointments     Appointment[]                    @relation("AppointmentCreatedBy")

  @@map("users")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  ipAddress String?
  userAgent String?
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verifications")
}

// ============================================================
// Organizaciones y membresías
// ============================================================

enum MemberRole {
  OWNER
  ADMIN
  AGENT
  VIEWER
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members                    OrganizationMember[]
  invitations                Invitation[]
  businessProfile            BusinessProfile?
  agentSettings              AgentSettings?
  products                   Product[]
  services                   Service[]
  faqs                       Faq[]
  auditLogs                  AuditLog[]
  conversations              Conversation[]
  messages                   Message[]
  customers                  Customer[]
  whatsappIntegrations       WhatsappIntegration[]
  whatsappSignupAttempts     WhatsappEmbeddedSignupAttempt[]
  whatsappWebhookReceipts    WhatsappWebhookReceipt[]
  knowledgeDocuments         KnowledgeDocument[]
  knowledgeChunks            KnowledgeChunk[]
  aiUsageEvents              AiUsageEvent[]
  agentToolUsages            AgentToolUsage[]
  automationEvents           AutomationEvent[]
  automationRuns             AutomationRun[]
  automationActionDeliveries AutomationActionDelivery[]
  integrationConnections     IntegrationConnection[]
  automationRules            OrganizationAutomationRule[]
  googleCalendarConnection   GoogleCalendarConnection?
  googleOAuthStates          GoogleOAuthState[]
  appointmentSettings        AppointmentSettings?
  appointments               Appointment[]

  @@map("organizations")
}

model OrganizationMember {
  id             String     @id @default(cuid())
  organizationId String
  userId         String
  role           MemberRole @default(VIEWER)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("organization_members")
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
}

model Invitation {
  id             String           @id @default(cuid())
  organizationId String
  email          String
  role           MemberRole       @default(VIEWER)
  token          String           @unique @default(cuid())
  status         InvitationStatus @default(PENDING)
  expiresAt      DateTime
  invitedById    String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy    User?        @relation("InvitedBy", fields: [invitedById], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@map("invitations")
}

// ============================================================
// Datos del negocio
// ============================================================

model BusinessProfile {
  id             String   @id @default(cuid())
  organizationId String   @unique
  name           String
  description    String?
  industry       String?
  phone          String?
  email          String?
  website        String?
  address        String?
  city           String?
  country        String?
  openingHours   String?
  paymentMethods String?
  shippingInfo   String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("business_profiles")
}

model Product {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  description    String?
  price          Decimal  @db.Decimal(12, 2)
  stock          Int      @default(0)
  category       String?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([organizationId, active])
  @@map("products")
}

model Service {
  id              String   @id @default(cuid())
  organizationId  String
  name            String
  description     String?
  price           Decimal  @db.Decimal(12, 2)
  durationMinutes Int      @default(30)
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("services")
}

model Faq {
  id             String   @id @default(cuid())
  organizationId String
  question       String
  answer         String
  category       String?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("faqs")
}

// ============================================================
// Configuración del futuro agente de IA (solo datos, sin IA)
// ============================================================

enum AgentTone {
  PROFESSIONAL
  FRIENDLY
  FORMAL
  CASUAL
}

model AgentSettings {
  id              String    @id @default(cuid())
  organizationId  String    @unique
  assistantName   String    @default("Asistente")
  tone            AgentTone @default(PROFESSIONAL)
  welcomeMessage  String    @default("¡Hola! ¿En qué puedo ayudarte?")
  fallbackMessage String    @default("No tengo esa información. Un miembro del equipo te va a responder a la brevedad.")
  handoffRules    String?
  enabled         Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("agent_settings")
}

// ============================================================
// Conversaciones del agente
// ============================================================

enum ConversationStatus {
  OPEN
  PENDING
  CLOSED
}

enum HandlingMode {
  AI
  HUMAN
}

enum SenderType {
  CUSTOMER
  AI
  HUMAN
  SYSTEM
}

enum WhatsappIntegrationStatus {
  CONNECTING
  CONNECTED
  ACTION_REQUIRED
  DISCONNECTED
  ERROR
}

enum WhatsappConnectionMethod {
  MANUAL
  EMBEDDED_SIGNUP
  COEXISTENCE
}

enum WhatsappChannelProvider {
  META_CLOUD
  YCLOUD
}

enum WhatsappEmbeddedSignupAttemptStatus {
  AWAITING_CODE
  PROCESSING
  SUCCEEDED
  FAILED
}

enum MessageDeliveryStatus {
  PENDING
  SENT
  DELIVERED
  READ
  FAILED
}

model WhatsappIntegration {
  id                   String                    @id @default(cuid())
  organizationId       String
  wabaId               String
  phoneNumberId        String                    @unique
  displayPhoneNumber   String
  verifiedName         String
  encryptedAccessToken String
  provider             WhatsappChannelProvider   @default(META_CLOUD)
  providerPhoneNumber  String?                   @unique
  status               WhatsappIntegrationStatus @default(DISCONNECTED)
  connectionMethod     WhatsappConnectionMethod  @default(MANUAL)
  businessId           String?
  tokenExpiresAt       DateTime?
  grantedScopes        String[]                  @default([])
  lastSyncedAt         DateTime?
  webhookSubscribedAt  DateTime?
  lastErrorCode        String?
  lastError            String?
  connectedAt          DateTime?
  lastWebhookAt        DateTime?
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt

  organization           Organization                    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  conversations          Conversation[]
  embeddedSignupAttempts WhatsappEmbeddedSignupAttempt[]
  webhookReceipts        WhatsappWebhookReceipt[]

  @@index([organizationId])
  @@index([organizationId, status])
  @@index([organizationId, provider, status])
  @@index([provider, wabaId])
  @@index([wabaId])
  @@map("whatsapp_integrations")
}

model WhatsappWebhookReceipt {
  id              String                  @id @default(cuid())
  organizationId  String
  integrationId   String
  provider        WhatsappChannelProvider
  externalEventId String
  eventType       String
  createdAt       DateTime                @default(now())

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  integration  WhatsappIntegration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@unique([provider, externalEventId])
  @@index([organizationId, createdAt])
  @@index([integrationId, createdAt])
  @@map("whatsapp_webhook_receipts")
}

model WhatsappEmbeddedSignupAttempt {
  id             String                              @id @default(cuid())
  organizationId String                              @unique
  userId         String
  integrationId  String?
  nonceHash      String                              @unique
  codeHash       String?                             @unique
  status         WhatsappEmbeddedSignupAttemptStatus @default(AWAITING_CODE)
  lastErrorCode  String?
  expiresAt      DateTime
  createdAt      DateTime                            @default(now())
  updatedAt      DateTime                            @updatedAt

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  integration  WhatsappIntegration? @relation(fields: [integrationId], references: [id], onDelete: SetNull)

  @@index([status, expiresAt])
  @@index([userId])
  @@map("whatsapp_embedded_signup_attempts")
}

model Customer {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  phone          String?
  email          String?
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  conversations Conversation[]
  appointments  Appointment[]

  @@index([organizationId])
  @@index([organizationId, phone])
  @@map("customers")
}

model Conversation {
  id                    String             @id @default(cuid())
  organizationId        String
  customerId            String?
  whatsappIntegrationId String?
  channel               String             @default("test")
  status                ConversationStatus @default(OPEN)
  handlingMode          HandlingMode       @default(AI)
  assignedUserId        String?
  humanTakeoverAt       DateTime?
  closedAt              DateTime?
  lastMessageAt         DateTime?
  unreadCount           Int                @default(0)
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  organization        Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer            Customer?            @relation(fields: [customerId], references: [id], onDelete: SetNull)
  whatsappIntegration WhatsappIntegration? @relation(fields: [whatsappIntegrationId], references: [id], onDelete: SetNull)
  assignedUser        User?                @relation("AssignedConversations", fields: [assignedUserId], references: [id], onDelete: SetNull)
  messages            Message[]
  automationEvents    AutomationEvent[]
  appointments        Appointment[]

  @@index([organizationId, channel, status])
  @@index([organizationId, lastMessageAt(sort: Desc)])
  @@index([whatsappIntegrationId])
  @@index([organizationId, customerId, channel, status])
  @@map("conversations")
}

model Message {
  id                String                 @id @default(cuid())
  organizationId    String
  conversationId    String
  senderType        SenderType
  senderUserId      String?
  content           String
  externalMessageId String?                @unique
  whatsappMessageId String?                @unique
  deliveryStatus    MessageDeliveryStatus?
  deliveryClaimedAt DateTime?
  errorCode         String?
  errorMessage      String?
  metadata          Json?
  createdAt         DateTime               @default(now())
  ingestedAt        DateTime               @default(now())
  readAt            DateTime?

  organization           Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  conversation           Conversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderUser             User?             @relation("SentMessages", fields: [senderUserId], references: [id], onDelete: SetNull)
  sourceAutomationEvents AutomationEvent[] @relation("AutomationSourceMessage")
  actionAutomationEvent  AutomationEvent?  @relation("AutomationActionMessage")

  @@index([conversationId, createdAt])
  @@index([organizationId, conversationId, ingestedAt])
  @@map("messages")
}

// ============================================================
// Auditoría
// ============================================================

model AuditLog {
  id             String   @id @default(cuid())
  organizationId String
  userId         String?
  action         String
  entityType     String?
  entityId       String?
  details        Json?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt(sort: Desc)])
  @@map("audit_logs")
}

// ============================================================
// Centro de conocimiento (Etapa 5)
// ============================================================

enum KnowledgeDocumentStatus {
  UPLOADED
  PROCESSING
  READY
  FAILED
  DISABLED
}

model KnowledgeDocument {
  id               String                  @id @default(cuid())
  organizationId   String
  uploadedByUserId String?
  name             String
  originalFilename String
  mimeType         String
  fileSize         Int
  storageKey       String
  category         String?
  status           KnowledgeDocumentStatus @default(UPLOADED)
  enabled          Boolean                 @default(true)
  extractedText    String?
  processingError  String?
  chunkCount       Int                     @default(0)
  processedAt      DateTime?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  uploadedBy   User?            @relation("KnowledgeUploads", fields: [uploadedByUserId], references: [id], onDelete: SetNull)
  chunks       KnowledgeChunk[]

  @@index([organizationId, status])
  @@index([organizationId, category])
  @@index([organizationId, createdAt(sort: Desc)])
  @@map("knowledge_documents")
}

model KnowledgeChunk {
  id             String   @id @default(cuid())
  organizationId String
  documentId     String
  chunkIndex     Int
  content        String
  tokenCount     Int?
  metadata       Json?
  createdAt      DateTime @default(now())

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  document     KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, chunkIndex])
  @@index([organizationId])
  @@index([documentId])
  @@map("knowledge_chunks")
}

// ============================================================
// Métricas: uso de IA y de herramientas del agente (Etapa 5)
// ============================================================

model AiUsageEvent {
  id               String   @id @default(cuid())
  organizationId   String
  conversationId   String?
  messageId        String?
  provider         String
  model            String
  inputTokens      Int      @default(0)
  outputTokens     Int      @default(0)
  cacheReadTokens  Int?
  cacheWriteTokens Int?
  latencyMs        Int      @default(0)
  success          Boolean  @default(true)
  errorType        String?
  toolCallsCount   Int      @default(0)
  createdAt        DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt(sort: Desc)])
  @@index([organizationId, provider, createdAt(sort: Desc)])
  @@map("ai_usage_events")
}

model AgentToolUsage {
  id             String   @id @default(cuid())
  organizationId String
  conversationId String?
  tool           String
  resultCount    Int?
  metadata       Json?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, tool, createdAt(sort: Desc)])
  @@index([organizationId, createdAt(sort: Desc)])
  @@map("agent_tool_usage")
}

// ============================================================
// Etapa 6A: Infraestructura de automatización (VantixApp <-> n8n)
// ============================================================

enum AutomationEventStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
  DEAD_LETTER
  CANCELLED
}

enum AutomationRunStatus {
  STARTED
  SUCCEEDED
  FAILED
}

enum IntegrationConnectionStatus {
  CONNECTED
  DISCONNECTED
  ERROR
}

enum AutomationRuleType {
  HANDOFF_ALERT
  FOLLOW_UP
}

enum AutomationActionDeliveryStatus {
  PROCESSING
  SENT
  FAILED
}

model OrganizationAutomationRule {
  id             String             @id @default(cuid())
  organizationId String
  type           AutomationRuleType
  enabled        Boolean            @default(false)
  config         Json
  version        Int                @default(1)
  createdById    String?
  updatedById    String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User?             @relation("AutomationRuleCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy    User?             @relation("AutomationRuleUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  events       AutomationEvent[]

  @@unique([organizationId, type])
  @@index([organizationId, enabled])
  @@map("organization_automation_rules")
}

model AutomationEvent {
  id                 String                @id @default(cuid())
  organizationId     String
  automationRuleId   String?
  conversationId     String?
  sourceMessageId    String?
  actionMessageId    String?               @unique
  type               String
  payload            Json
  schemaVersion      Int                   @default(1)
  status             AutomationEventStatus @default(PENDING)
  idempotencyKey     String
  attempts           Int                   @default(0)
  maxAttempts        Int                   @default(5)
  nextAttemptAt      DateTime?
  lockedAt           DateTime?
  processedAt        DateTime?
  lastError          String?
  followUpNumber     Int?
  cancellationReason String?
  actionClaimedAt    DateTime?
  actionCompletedAt  DateTime?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  organization     Organization                @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  automationRule   OrganizationAutomationRule? @relation(fields: [automationRuleId], references: [id], onDelete: SetNull)
  conversation     Conversation?               @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  sourceMessage    Message?                    @relation("AutomationSourceMessage", fields: [sourceMessageId], references: [id], onDelete: SetNull)
  actionMessage    Message?                    @relation("AutomationActionMessage", fields: [actionMessageId], references: [id], onDelete: SetNull)
  runs             AutomationRun[]
  actionDeliveries AutomationActionDelivery[]

  @@unique([organizationId, idempotencyKey])
  @@unique([organizationId, type, sourceMessageId])
  @@unique([organizationId, id])
  @@index([status, nextAttemptAt])
  @@index([organizationId, type, status, nextAttemptAt])
  @@index([organizationId, conversationId, type, status])
  @@index([conversationId])
  @@index([automationRuleId, createdAt(sort: Desc)])
  @@index([sourceMessageId])
  @@index([organizationId, createdAt(sort: Desc)])
  @@map("automation_events")
}

model AutomationRun {
  id                  String              @id @default(cuid())
  organizationId      String
  automationEventId   String
  provider            String
  status              AutomationRunStatus @default(STARTED)
  attempt             Int
  externalExecutionId String?
  startedAt           DateTime            @default(now())
  finishedAt          DateTime?
  durationMs          Int?
  errorCode           String?
  errorMessage        String?
  responseMeta        Json?
  createdAt           DateTime            @default(now())

  organization    Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  automationEvent AutomationEvent @relation(fields: [automationEventId], references: [id], onDelete: Cascade)

  @@index([automationEventId])
  @@index([organizationId, createdAt(sort: Desc)])
  @@map("automation_runs")
}

model AutomationActionDelivery {
  id                  String                         @id @default(cuid())
  organizationId      String
  eventId             String
  recipientHash       String
  status              AutomationActionDeliveryStatus @default(PROCESSING)
  templateName        String
  templateLanguage    String
  externalMessageId   String?
  errorCode           String?
  errorMessage        String?
  processingStartedAt DateTime                       @default(now())
  completedAt         DateTime?
  createdAt           DateTime                       @default(now())
  updatedAt           DateTime                       @updatedAt

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  event        AutomationEvent @relation(fields: [organizationId, eventId], references: [organizationId, id], onDelete: Cascade)

  @@unique([eventId, recipientHash])
  @@index([organizationId, status, createdAt(sort: Desc)])
  @@index([organizationId, eventId, status])
  @@map("automation_action_deliveries")
}

model IntegrationConnection {
  id              String                      @id @default(cuid())
  organizationId  String
  provider        String                      @default("n8n")
  status          IntegrationConnectionStatus @default(DISCONNECTED)
  enabled         Boolean                     @default(false)
  externalId      String?
  encryptedSecret String?
  lastEventAt     DateTime?
  lastCallbackAt  DateTime?
  lastError       String?
  createdAt       DateTime                    @default(now())
  updatedAt       DateTime                    @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, provider])
  @@index([organizationId])
  @@map("integration_connections")
}

// ============================================================
// Etapa 6D.1A: Google Calendar (conexión OAuth base)
// ============================================================

enum GoogleCalendarConnectionStatus {
  CONNECTED
  ERROR
}

model GoogleCalendarConnection {
  id                    String                         @id @default(cuid())
  organizationId        String                         @unique
  status                GoogleCalendarConnectionStatus @default(CONNECTED)
  googleEmail           String?
  selectedCalendarId    String?
  selectedCalendarName  String?
  grantedScopes         String[]                       @default([])
  encryptedAccessToken  String
  encryptedRefreshToken String
  accessTokenExpiresAt  DateTime
  connectedByUserId     String?
  lastError             String?
  lastTestedAt          DateTime?
  createdAt             DateTime                       @default(now())
  updatedAt             DateTime                       @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("google_calendar_connections")
}

model GoogleOAuthState {
  id             String    @id @default(cuid())
  organizationId String
  userId         String
  stateHash      String    @unique
  expiresAt      DateTime
  usedAt         DateTime?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, expiresAt])
  @@map("google_oauth_states")
}

// ============================================================
// Etapa 6D.1B (parte 1): configuración de turnos y disponibilidad
// ============================================================

model AppointmentSettings {
  id                     String   @id @default(cuid())
  organizationId         String   @unique
  enabled                Boolean  @default(false)
  timeZone               String   @default("UTC")
  defaultDurationMinutes Int      @default(30)
  bufferMinutes          Int      @default(0)
  minimumNoticeMinutes   Int      @default(120)
  maxAdvanceDays         Int      @default(30)
  weeklySchedule         Json
  location               String?
  defaultEventTitle      String   @default("Turno")
  allowRescheduling      Boolean  @default(false)
  allowCancellation      Boolean  @default(false)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("appointment_settings")
}

// ============================================================
// Etapa 6D.1B-B: turnos sincronizados con Google Calendar
// ============================================================

enum AppointmentStatus {
  PENDING
  CONFIRMED
  RESCHEDULED
  CANCELLED
  FAILED
}

enum AppointmentSource {
  MANUAL
  AI
}

model Appointment {
  id                 String            @id @default(cuid())
  organizationId     String
  customerId         String?
  conversationId     String?
  googleEventId      String?
  calendarId         String
  startAt            DateTime
  endAt              DateTime
  timezone           String
  status             AppointmentStatus @default(PENDING)
  title              String
  customerName       String
  customerPhone      String?
  notes              String?
  cancellationReason String?
  createdByUserId    String?
  source             AppointmentSource @default(MANUAL)
  idempotencyKey     String
  lastOperationKey   String?
  lastError          String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  createdBy    User?         @relation("AppointmentCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@unique([organizationId, idempotencyKey])
  @@unique([organizationId, googleEventId])
  @@unique([organizationId, id])
  @@index([organizationId, status, startAt])
  @@index([organizationId, startAt])
  @@index([organizationId, customerId, startAt])
  @@index([organizationId, conversationId])
  @@map("appointments")
}

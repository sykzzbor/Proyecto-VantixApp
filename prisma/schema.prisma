// ============================================================
// Etapa 6D.1B (parte 1): configuración de turnos y disponibilidad
// ============================================================

model AppointmentSettings {
  id                     String   @id @default(cuid())
  organizationId         String   @unique
  enabled                Boolean  @default(false)
  timeZone               String   @default("UTC")
  defaultDurationMinutes Int      @default(30)
  bufferMinutes          Int      @default(0)
  minimumNoticeMinutes   Int      @default(120)
  maxAdvanceDays         Int      @default(30)
  weeklySchedule         Json
  location               String?
  defaultEventTitle      String   @default("Turno")
  allowRescheduling      Boolean  @default(false)
  allowCancellation      Boolean  @default(false)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("appointment_settings")
}

// ============================================================
// Etapa 6D.1B-B: turnos sincronizados con Google Calendar
// ============================================================

enum AppointmentStatus {
  PENDING
  CONFIRMED
  RESCHEDULED
  CANCELLED
  FAILED
}

enum AppointmentSource {
  MANUAL
  AI
}

model Appointment {
  id                 String            @id @default(cuid())
  organizationId     String
  customerId         String?
  conversationId     String?
  googleEventId      String?
  calendarId         String
  startAt            DateTime
  endAt              DateTime
  timezone           String
  status             AppointmentStatus @default(PENDING)
  title              String
  customerName       String
  customerPhone      String?
  notes              String?
  cancellationReason String?
  createdByUserId    String?
  source             AppointmentSource @default(MANUAL)
  idempotencyKey     String
  lastOperationKey   String?
  lastError          String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  createdBy    User?         @relation("AppointmentCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@unique([organizationId, idempotencyKey])
  @@unique([organizationId, googleEventId])
  @@unique([organizationId, id])
  @@index([organizationId, status, startAt])
  @@index([organizationId, startAt])
  @@index([organizationId, customerId, startAt])
  @@index([organizationId, conversationId])
  @@map("appointments")
}
